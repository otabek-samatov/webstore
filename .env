# =============================================================================
# Port configuration for docker-compose.yml
#
# Docker Compose auto-loads this file and substitutes ${VAR} placeholders in
# docker-compose.yml. This is the single place to change any port used by the
# Compose stack — mappings, healthchecks, and the *_SERVICE_URL targets all
# read from here.
#
# NOT secret: these are committed on purpose (unlike ./secrets/). Do not put
# credentials here.
#
# IMPORTANT: the *_SERVICE_PORT values below are the CONTAINER-INTERNAL ports
# and must stay in sync with `server.port` in the config repo
# (webstore-config/config/<service>.yml). Compose cannot read that repo, so if
# you change a service's port you must edit BOTH places.
# =============================================================================

# --- Application services (container-internal port == host-published port) ---
CONFIG_SERVICE_PORT=8071
GATEWAY_SERVICE_PORT=8072
PRODUCT_SERVICE_PORT=8073
INVENTORY_SERVICE_PORT=8074
USER_SERVICE_PORT=8075
ORDER_SERVICE_PORT=8077
PAYMENT_SERVICE_PORT=8078

# --- Infrastructure ---
POSTGRES_PORT=5432

# Kafka client listeners:
#   KAFKA_PORT           PLAINTEXT, advertised as localhost:<port> (host apps)
#   KAFKA_INTERNAL_PORT  INTERNAL,  advertised as kafka:<port>     (containers)
#   KAFKA_CONTROLLER_PORT  KRaft controller quorum (single node)
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=19092
KAFKA_CONTROLLER_PORT=29093
