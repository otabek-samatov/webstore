{
  "uid": "webstore-services",
  "title": "Webstore Services",
  "description": "Spring Boot service overview: HTTP traffic, latency, errors, JVM and DB pool. Select a service with the $service variable.",
  "tags": ["webstore", "spring-boot"],
  "schemaVersion": 39,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up{job!=\"prometheus\"}, job)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": { "text": "gateway-service", "value": "gateway-service" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Services Up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job!=\"prometheus\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP Request Rate by Status ($service)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"$service\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP Latency ($service)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"$service\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"$service\"}[5m]))",
          "legendFormat": "avg"
        },
        {
          "refId": "B",
          "expr": "max(http_server_requests_seconds_max{job=\"$service\"})",
          "legendFormat": "max"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP 5xx Error Rate ($service)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"$service\", status=~\"5..\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "JVM Heap ($service)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"$service\", area=\"heap\"})",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{job=\"$service\", area=\"heap\"})",
          "legendFormat": "max"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU Usage ($service)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 21 },
      "targets": [
        { "refId": "A", "expr": "process_cpu_usage{job=\"$service\"}", "legendFormat": "process" },
        { "refId": "B", "expr": "system_cpu_usage{job=\"$service\"}", "legendFormat": "system" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GC Pause Time / s ($service)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 21 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (action, cause) (rate(jvm_gc_pause_seconds_sum{job=\"$service\"}[5m]))",
          "legendFormat": "{{action}} ({{cause}})"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Live Threads ($service)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 21 },
      "targets": [
        { "refId": "A", "expr": "jvm_threads_live_threads{job=\"$service\"}", "legendFormat": "live" },
        { "refId": "B", "expr": "jvm_threads_daemon_threads{job=\"$service\"}", "legendFormat": "daemon" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HikariCP Connections ($service)",
      "description": "Empty for config-service and gateway-service — they have no database.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "targets": [
        { "refId": "A", "expr": "hikaricp_connections_active{job=\"$service\"}", "legendFormat": "active" },
        { "refId": "B", "expr": "hikaricp_connections_idle{job=\"$service\"}", "legendFormat": "idle" },
        { "refId": "C", "expr": "hikaricp_connections_pending{job=\"$service\"}", "legendFormat": "pending" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Logback Events / s ($service)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (rate(logback_events_total{job=\"$service\"}[5m]))",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    }
  ]
}
