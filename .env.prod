# =============================================================================
# PROD environment parameters for docker-compose.yml
#
#   docker compose --env-file .env.prod up -d
#
# IMPORTANT: --env-file REPLACES the default .env (Compose does NOT merge them),
# so this file must be COMPLETE — every variable the stack needs is listed here.
#
# NOT secret: committed on purpose. Never put production credentials here — DB
# creds come from ./secrets/ (or an external secret manager). For managed PROD
# infrastructure, point DB_HOST / KAFKA_BROKERS at the real endpoints; these are
# currently hardcoded to the compose containers in docker-compose.yml, so
# parameterize them there (and likely drop the postgres/kafka services via a
# docker-compose.prod.yml override) if PROD uses external DB/Kafka.
# =============================================================================

# --- Active Spring profile (selects config-repo overlays) ---
SPRING_PROFILE=prod

# --- Application services (container-internal port == host-published port) ---
CONFIG_SERVICE_PORT=8071
GATEWAY_SERVICE_PORT=8072
PRODUCT_SERVICE_PORT=8073
INVENTORY_SERVICE_PORT=8074
USER_SERVICE_PORT=8075
ORDER_SERVICE_PORT=8077
PAYMENT_SERVICE_PORT=8078

# --- Infrastructure ---
POSTGRES_PORT=5432

# Kafka client listeners (see .env for the meaning of each).
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=19092
KAFKA_CONTROLLER_PORT=29093

# --- Monitoring (host-published ports; containers listen on 9090/3000) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
